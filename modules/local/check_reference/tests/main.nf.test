nextflow_process {

    name "Test Process CHECK_REFERENCE"
    script "../main.nf"
    process "CHECK_REFERENCE"
    tag "modules"
    tag "modules_local"
    tag "check_reference"

    // VCF cases (renaming, header length fixes) are tested with the extracted facts in
    // subworkflows/local/preprocess_vcf/tests

    test("bed - no-chr names are renamed, unknown contigs dropped") {

        when {
            process {
                """
                def base = params.pipelines_testdata_base_path + 'synthetic/'
                def bed = file("${outputDir}/no_chr.bed")
                bed.parent.mkdirs()
                bed.text = '1\\t100\\t200\\tA\\nchrUn_x\\t1\\t5\\tB\\nMT\\t10\\t20\\tC\\n'
                input[0] = [[id: 'no_chr'], bed]
                input[1] = 'bed'
                input[2] = [[id: 'synthetic'], file(base + 'reference/synthetic.fa.fai', checkIfExists: true)]
                input[3] = []
                """
            }
        }

        then {
            def report = path(process.out.report[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert report.contains('status\tfixed') },
                { assert path(process.out.bed[0][1]).text == 'chr1\t100\t200\tA\nchrM\t10\t20\tC\n' },
                { assert snapshot(process.out.rename, process.out.keep, process.out.bed).match() }
            )
        }
    }

    test("bed - interval beyond contig end fails (different build)") {

        when {
            process {
                """
                def base = params.pipelines_testdata_base_path + 'synthetic/'
                def bed = file("${outputDir}/wrong_build.bed")
                bed.parent.mkdirs()
                bed.text = 'chr1\\t100\\t200\\nchr1\\t29000\\t31000\\n'
                input[0] = [[id: 'wrong_build'], bed]
                input[1] = 'bed'
                input[2] = [[id: 'synthetic'], file(base + 'reference/synthetic.fa.fai', checkIfExists: true)]
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains('on another genome build') } }
            )
        }
    }

    test("vcf - stub") {

        options "-stub"

        when {
            process {
                """
                def base = params.pipelines_testdata_base_path + 'synthetic/'
                def header = file("${outputDir}/header.vcf")
                header.parent.mkdirs()
                header.text = '##fileformat=VCFv4.2\\n'
                def contigs = file("${outputDir}/contigs.txt")
                contigs.text = 'chr1\\n'
                input[0] = [[id: 'S1_wgs'], [header, contigs]]
                input[1] = 'vcf'
                input[2] = [[id: 'synthetic'], file(base + 'reference/synthetic.fa.fai', checkIfExists: true)]
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
