nextflow_function {

    name "Test samplesheet functions"
    script "../main.nf"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_variantcomp_pipeline"

    test("samplesheetErrors - valid samplesheet has no errors") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), row.call('S1','wes','capture','/bed/wes.bed'), row.call('S2','wgs','wgs',null), row.call('S2','wes','capture','/bed/wes.bed')]
                input[1] = 'wgs'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [] }
            )
        }
    }

    test("samplesheetErrors - duplicate rows") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), row.call('S1','wgs','wgs',null), row.call('S1','wes','capture','/bed/wes.bed')]
                input[1] = 'wgs'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.any { it.contains('Duplicate rows') } }
            )
        }
    }

    test("samplesheetErrors - only one technology") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), row.call('S2','wgs','wgs',null)]
                input[1] = 'wgs'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.any { it.contains('At least two technologies') } }
            )
        }
    }

    test("samplesheetErrors - truth technology not in samplesheet") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), row.call('S1','wes','capture','/bed/wes.bed')]
                input[1] = 'panel'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.any { it.contains("Truth technology 'panel' is not in the samplesheet") } }
            )
        }
    }

    test("samplesheetErrors - sample without truth row") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), row.call('S1','wes','capture','/bed/wes.bed'), row.call('S2','wes','capture','/bed/wes.bed')]
                input[1] = 'wgs'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ["Sample 'S2' has no row for the truth technology 'wgs'"] }
            )
        }
    }

    test("samplesheetErrors - sample with only the truth technology") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), row.call('S1','wes','capture','/bed/wes.bed'), row.call('S2','wgs','wgs',null)]
                input[1] = 'wgs'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ["Sample 'S2' has no technology to compare with the truth technology 'wgs'"] }
            )
        }
    }

    test("samplesheetErrors - different BEDs within one technology") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), row.call('S1','wes','capture','/bed/wes.bed'), row.call('S2','wgs','wgs',null), row.call('S2','wes','capture','/bed/other.bed')]
                input[1] = 'wgs'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.any { it.contains("Technology 'wes' must use one target BED") } }
            )
        }
    }

    test("samplesheetErrors - targeted technology without BED") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), row.call('S1','panel','amplicon',null)]
                input[1] = 'wgs'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.any { it.contains("Technology 'panel' (library_type amplicon) requires a target_bed") } }
            )
        }
    }

    test("samplesheetErrors - identical tumor and normal id") {

        function "samplesheetErrors"

        when {
            function {
                """
                def row = { sample, tech, lib, bed ->
                    [[id: sample + '_' + tech, sample: sample, technology: tech, library_type: lib,
                      tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                     file('/data/' + sample + '_' + tech + '.vcf.gz'), [], [], [], [], [], bed ? file(bed) : []]
                }
                input[0] = [row.call('S1','wgs','wgs',null), [row.call('S1','wes','capture','/bed/wes.bed')[0] + [normal_id: 'S1_wes_T']] + row.call('S1','wes','capture','/bed/wes.bed')[1..-1]]
                input[1] = 'wgs'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.any { it.contains('tumor_id and normal_id are identical') } }
            )
        }
    }

    test("resolveSamplesheetPath - n/a gives an empty list") {

        function "resolveSamplesheetPath"

        when {
            function {
                """
                input[0] = 'n/a'
                input[1] = file('/sheets')
                """
            }
        }

        then {
            assert function.success
            assert function.result == []
        }
    }

    test("buildSamplesheetEntries - resolves relative paths and sets meta") {

        function "buildSamplesheetEntries"

        when {
            function {
                """
                input[0] = [
                    [[sample: 'S1', technology: 'wes', library_type: 'capture', tumor_id: 'T', normal_id: 'n/a', caller: 'dragen'],
                     'vcf/S1.vcf.gz', 'n/a', 'n/a', 'n/a', [], [], '/abs/wes.bed'],
                    [[sample: 'S1', technology: 'wgs', library_type: 'wgs', tumor_id: 'T', normal_id: 'N', caller: null],
                     'https://example.org/S1.vcf.gz', [], [], [], [], [], 'n/a']
                ]
                input[1] = file('/sheets')
                input[2] = 'wgs'
                """
            }
        }

        then {
            def entries = function.result
            assertAll(
                { assert function.success },
                { assert entries[0][0].id == 'S1_wes' },
                { assert entries[0][0].normal_id == null },
                { assert entries[0][0].is_truth == false },
                { assert entries[0][1].toString() == '/sheets/vcf/S1.vcf.gz' },
                { assert entries[0][2] == [] },
                { assert entries[0][7].toString() == '/abs/wes.bed' },
                { assert entries[1][0].is_truth == true },
                { assert entries[1][0].caller == 'unknown' },
                // nf-test serializes paths without URL scheme/host; check the URL was not resolved against the samplesheet dir
                { assert entries[1][1].toString() == '/S1.vcf.gz' },
                { assert entries[1][7] == [] }
            )
        }
    }

    test("missingSamplesheetFiles - reports missing files") {

        function "missingSamplesheetFiles"

        when {
            function {
                """
                input[0] = [[[id: 'S1_wes'], file('/does/not/exist.vcf.gz'), [], [], [], [], [], []]]
                """
            }
        }

        then {
            assert function.success
            assert function.result == ["Row 'S1_wes': vcf not found: /does/not/exist.vcf.gz"]
        }
    }
}
