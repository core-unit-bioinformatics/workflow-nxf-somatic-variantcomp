nextflow_workflow {

    name "Test Subworkflow COVERAGE"
    script "../main.nf"
    workflow "COVERAGE"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "coverage"
    tag "mosdepth"

    test("seqc2 small - callable region for the sample with alignments, common region otherwise") {

        when {
            workflow {
                """
                def base = params.pipelines_testdata_base_path + 'seqc2/small/'
                def entry = { pair, tech, lib, bams ->
                    def b = { role -> bams ? file(base + 'bam/' + pair + '_' + tech + '_' + role + '.bam') : [] }
                    def i = { role -> bams ? file(base + 'bam/' + pair + '_' + tech + '_' + role + '.bam.bai') : [] }
                    [[id: 'SEQC2_' + pair + '_' + tech, sample: 'SEQC2_' + pair, technology: tech, library_type: lib,
                      tumor_id: 'TUMOR', normal_id: 'NORMAL'],
                     file(base + 'vcf/' + pair + '_' + tech + '.bwa.muTect2.vcf.gz'), [], b.call('T'), i.call('T'), b.call('N'), i.call('N'), []]
                }
                // alignments are indexed (missing indices are created by PREPARE_ALIGNMENTS)
                input[0] = channel.of(entry.call('IL_1', 'wgs', 'wgs', true), entry.call('IL_1', 'wes', 'capture', true),
                                      entry.call('FD_1', 'wgs', 'wgs', false), entry.call('FD_1', 'wes', 'capture', false))
                // rename maps of the alignment checks (CHECK_INPUTS): the alignments use the
                // reference names, so the maps are empty
                def rename = file("${outputDir}/empty.rename_chrs.tsv")
                rename.parent.mkdirs()
                rename.text = ''
                input[1] = channel.of('IL_1_wgs_tumor', 'IL_1_wgs_normal', 'IL_1_wes_tumor', 'IL_1_wes_normal')
                    .map { id -> [[id: 'SEQC2_' + id], rename] }
                input[2] = channel.value([[id: 'chr22'], file(base + 'reference/GRCh38.d1.vd1_chr22.fa.gz'),
                                          file(base + 'reference/GRCh38.d1.vd1_chr22.fa.gz.fai'), file(base + 'reference/GRCh38.d1.vd1_chr22.fa.gz.gzi')])
                input[3] = channel.value(file(base + 'bed/S07604624_Covered_human_all_v6_plus_UTR_hg38.bed'))
                input[4] = true
                """
            }
        }

        then {
            def regions = workflow.out.regions.collectEntries { item -> [(item[0].id): file(item[1]).name] }
            def summary = path(workflow.out.callable_summary[0][1]).readLines()
            assertAll(
                { assert workflow.success },
                { assert regions == [
                    SEQC2_IL_1_wgs: 'SEQC2_IL_1.callable.bed', SEQC2_IL_1_wes: 'SEQC2_IL_1.callable.bed',
                    SEQC2_FD_1_wgs: 'S07604624_Covered_human_all_v6_plus_UTR_hg38.bed', SEQC2_FD_1_wes: 'S07604624_Covered_human_all_v6_plus_UTR_hg38.bed'] },
                // min_coverage: tumor/normal threshold
                { assert summary[1].startsWith('SEQC2_IL_1\t4\tbase\t10/10\t1987915\t') },
                // mosdepth summaries for MultiQC: global, summary and regions per alignment
                { assert workflow.out.multiqc_files.size() == 12 },
                { assert snapshot(workflow.out.callable, workflow.out.callable_summary).match() }
            )
        }
    }
}
