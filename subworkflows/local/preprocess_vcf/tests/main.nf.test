nextflow_workflow {

    name "Test Subworkflow PREPROCESS_VCF"
    script "../main.nf"
    workflow "PREPROCESS_VCF"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "preprocess_vcf"
    tag "bcftools/view"
    tag "bcftools/annotate"
    tag "bcftools/reheader"
    tag "bcftools/norm"
    tag "bcftools/concat"

    test("synthetic - PASS branch, normalization, harmonization and filtering follow the design") {

        when {
            workflow {
                """
                def base = params.pipelines_testdata_base_path + 'synthetic/'
                def entry = { sample, tech -> [[id: sample + '_' + tech, sample: sample, technology: tech,
                                                tumor_id: sample + '_' + tech + '_T', normal_id: sample + '_' + tech + '_N'],
                                               file(base + 'vcf/' + sample + '_' + tech + '.vcf.gz'),
                                               file(base + 'vcf/' + sample + '_' + tech + '.vcf.gz.tbi'), [], [], [], [], []] }
                // genome BED of PREPARE_REFERENCE: compared contigs, chrM excluded (--keep_mito false)
                def genome = file("${outputDir}/genome.bed")
                genome.parent.mkdirs()
                genome.text = 'chr1\\t0\\t30000\\nchr2\\t0\\t20000\\n'
                // rename maps as CHECK_INPUTS writes them: only S2_panel uses 1/2/MT names
                // (MT is not mapped: the mitochondrial contig is dropped)
                def no_rename = file("${outputDir}/none.rename_chrs.tsv")
                no_rename.text = ''
                def s2_panel_rename = file("${outputDir}/S2_panel.rename_chrs.tsv")
                s2_panel_rename.text = '1\\tchr1\\n2\\tchr2\\n'
                def entries = channel.of(entry.call('S1', 'wgs'), entry.call('S1', 'wes'), entry.call('S1', 'panel'), entry.call('S2', 'panel'), entry.call('S2', 'wgs'), entry.call('S2', 'wes'))
                input[0] = entries
                input[1] = entries.map { e -> [e[0], e[0].id == 'S2_panel' ? s2_panel_rename : no_rename] }
                input[2] = channel.value([[id: 'synthetic'], file(base + 'reference/synthetic.fa'), file(base + 'reference/synthetic.fa.fai'), []])
                input[3] = channel.value(genome)
                input[4] = entries.map { e -> [e[0], file(base + 'bed/panel.bed')] }
                input[5] = true
                """
            }
        }

        then {
            def records = { channel_out, id ->
                def vcf = channel_out.find { item -> item[0].id == id }[1]
                path(vcf).linesGzip.findAll { line -> !line.startsWith('#') }.collect { line -> line.tokenize('\t')[0..4].join(':') }
            }
            def filters = { channel_out, id ->
                def vcf = channel_out.find { item -> item[0].id == id }[1]
                path(vcf).linesGzip.findAll { line -> !line.startsWith('#') }.collect { line -> line.tokenize('\t')[6] }
            }
            def header = { channel_out, id ->
                def vcf = channel_out.find { item -> item[0].id == id }[1]
                path(vcf).linesGzip.findAll { line -> line.startsWith('##contig') || line.startsWith('#CHROM') }
            }
            assertAll(
                { assert workflow.success },
                // E01 dedup, E03 low VAF FP, E04 MNV atomized, E05 left-aligned, E06, E08, E11, E13; outside region dropped
                { assert records(workflow.out.compare, 'S1_panel') == [
                    'chr1:4100:.:A:C', 'chr1:4300:.:C:G', 'chr1:4400:.:A:C', 'chr1:4401:.:C:T', 'chr1:4600:.:A:C',
                    'chr1:4700:.:G:T', 'chr1:4999:.:GA:G', 'chr1:8500:.:G:T', 'chr2:2500:.:CTAG:C'] },
                // E02 kept despite <NON_REF>, E04 MNV atomized, E06 split (extra allele kept), E08 filtered, E10 removed, E12 left-aligned
                { assert records(workflow.out.compare, 'S1_wes') == [
                    'chr1:4100:.:A:C', 'chr1:4200:.:A:C', 'chr1:4400:.:A:C', 'chr1:4401:.:C:T', 'chr1:4600:.:A:C',
                    'chr1:4600:.:A:G', 'chr1:4999:.:GA:G', 'chr1:8500:.:G:T', 'chr2:2500:.:CTAG:C', 'chr2:2999:.:G:GCA'] },
                // only PASS records are compared; the normalized VCF holds both branches
                { assert workflow.out.compare.every { item -> filters(workflow.out.compare, item[0].id).every { f -> f == 'PASS' } } },
                { assert filters(workflow.out.normalized, 'S1_wes').any { f -> f != 'PASS' } },
                // E07/E14 outside the region are kept in the normalized VCF only
                { assert records(workflow.out.normalized, 'S1_wgs').size() == 12 },
                { assert records(workflow.out.compare, 'S1_wgs').size() == 10 },
                // S2 panel: 1/2 renamed, MT (chrM) dropped, contig lines from the reference
                { assert records(workflow.out.normalized, 'S2_panel') == [
                    'chr1:4150:.:C:G', 'chr1:5500:.:A:C', 'chr2:4000:.:C:G', 'chr2:4500:.:G:T'] },
                { assert header(workflow.out.normalized, 'S2_panel')[0..1] == [
                    '##contig=<ID=chr1,length=30000>', '##contig=<ID=chr2,length=20000>'] },
                // S2 wgs: normal column came first in the input; tumor is first now
                { assert header(workflow.out.normalized, 'S2_wgs').last().endsWith('FORMAT\tS2_wgs_T\tS2_wgs_N') },
                // bcftools norm logs and harmonization summaries: one per VCF and branch
                { assert workflow.out.norm_logs.size() == 12 },
                { assert workflow.out.summaries.size() == 12 },
                // accounting: one table per VCF; every consistency check ok; E08 removed as non-PASS
                { assert workflow.out.checks.size() == 6 },
                { assert workflow.out.checks.every { item -> path(item[1]).readLines().drop(1).every { line -> line.endsWith('\tok') } } },
                { assert path(workflow.out.removed.find { item -> item[0].id == 'S1_wes' }[1]).text.contains('pass_split\tfilter_not_pass\tchr1\t4700') }
            )
        }
    }

    test("synthetic - without --filter_pass_only all records are compared") {

        when {
            workflow {
                """
                def base = params.pipelines_testdata_base_path + 'synthetic/'
                def genome = file("${outputDir}/genome.bed")
                genome.parent.mkdirs()
                genome.text = 'chr1\\t0\\t30000\\nchr2\\t0\\t20000\\n'
                def no_rename = file("${outputDir}/none.rename_chrs.tsv")
                no_rename.text = ''
                def meta = [id: 'S1_wes', sample: 'S1', technology: 'wes', tumor_id: 'S1_wes_T', normal_id: 'S1_wes_N']
                input[0] = channel.of([meta, file(base + 'vcf/S1_wes.vcf.gz'), file(base + 'vcf/S1_wes.vcf.gz.tbi'), [], [], [], [], []])
                input[1] = channel.of([meta, no_rename])
                input[2] = channel.value([[id: 'synthetic'], file(base + 'reference/synthetic.fa'), file(base + 'reference/synthetic.fa.fai'), []])
                input[3] = channel.value(genome)
                input[4] = channel.of([meta, file(base + 'bed/panel.bed')])
                input[5] = false
                """
            }
        }

        then {
            def filters = path(workflow.out.compare[0][1]).linesGzip.findAll { line -> !line.startsWith('#') }.collect { line -> line.tokenize('\t')[6] }
            assertAll(
                { assert workflow.success },
                { assert filters.any { f -> f != 'PASS' } },
                { assert workflow.out.norm_logs.size() == 1 },
                { assert workflow.out.summaries.size() == 1 },
                // without the PASS split, no record is removed as non-PASS; all checks ok
                { assert !path(workflow.out.removed[0][1]).text.contains('filter_not_pass') },
                { assert path(workflow.out.checks[0][1]).readLines().drop(1).every { line -> line.endsWith('\tok') } }
            )
        }
    }

    test("synthetic - overlapping alleles: atomized complex call and spanning deletion") {

        when {
            workflow {
                """
                def base = params.pipelines_testdata_base_path + 'synthetic/'
                def genome = file("${outputDir}/genome.bed")
                genome.parent.mkdirs()
                genome.text = 'chr1\\t0\\t30000\\nchr2\\t0\\t20000\\n'
                def no_rename = file("${outputDir}/none.rename_chrs.tsv")
                no_rename.text = ''
                // DRAGEN-like VCF (plain text, no index; bcftools view -s needs the contig lines) with
                // G01: complex call CG>CTGTATAAGAGGT (insertion + SNV at chr1:4806); bcftools norm
                //      --atomize writes 'G GGTATAAGAGGT,*' and 'G T,*' with the default --atom-overlaps '*'
                // G02: deletion chr2:2612 CTGA>C spanning chr2:2614 G>A,* ('*': the deletion allele)
                def vcf = file("${outputDir}/S3_wes.vcf")
                vcf.text = [
                    '##fileformat=VCFv4.2',
                    '##FILTER=<ID=PASS,Description="All filters passed">',
                    '##contig=<ID=chr1,length=30000>',
                    '##contig=<ID=chr2,length=20000>',
                    '##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">',
                    '##FORMAT=<ID=AD,Number=R,Type=Integer,Description="Allelic depths">',
                    '##FORMAT=<ID=AF,Number=A,Type=Float,Description="Allele fractions">',
                    '##FORMAT=<ID=DP,Number=1,Type=Integer,Description="Read depth">',
                    ['#CHROM', 'POS', 'ID', 'REF', 'ALT', 'QUAL', 'FILTER', 'INFO', 'FORMAT', 'S3_wes_T', 'S3_wes_N'].join('\\t'),
                    ['chr1', '4805', '.', 'CG', 'CTGTATAAGAGGT', '.', 'PASS', '.', 'GT:AD:AF:DP', '0/1:140,60:0.300:200', '0/0:200,0:0.000:200'].join('\\t'),
                    ['chr2', '2612', '.', 'CTGA', 'C', '.', 'PASS', '.', 'GT:AD:AF:DP', '0/1:140,60:0.300:200', '0/0:200,0:0.000:200'].join('\\t'),
                    ['chr2', '2614', '.', 'G', 'A,*', '.', 'PASS', '.', 'GT:AD:AF:DP', '1/2:110,30,60:0.150,0.300:200', '0/0:200,0,0:0.000,0.000:200'].join('\\t'),
                ].join('\\n') + '\\n'
                def meta = [id: 'S3_wes', sample: 'S3', technology: 'wes', tumor_id: 'S3_wes_T', normal_id: 'S3_wes_N']
                input[0] = channel.of([meta, vcf, [], [], [], [], [], []])
                input[1] = channel.of([meta, no_rename])
                input[2] = channel.value([[id: 'synthetic'], file(base + 'reference/synthetic.fa'), file(base + 'reference/synthetic.fa.fai'), []])
                input[3] = channel.value(genome)
                input[4] = channel.of([meta, file(base + 'bed/panel.bed')])
                input[5] = true
                """
            }
        }

        then {
            def records = path(workflow.out.compare[0][1]).linesGzip.findAll { line -> !line.startsWith('#') }.collect { line -> line.tokenize('\t')[0..4].join(':') }
            def summary = path(workflow.out.summaries.find { item -> item[1].toString().contains('.pass.') }[1]).readLines()
            def accounting = path(workflow.out.accounting[0][1]).readLines()
            assertAll(
                { assert workflow.success },
                // G01 atomized into one-ALT records; G02 deletion and SNV kept, its 'G>*' half dropped
                { assert records == [
                    'chr1:4806:.:G:GGTATAAGAGGT', 'chr1:4806:.:G:T', 'chr2:2612:.:CTGA:C', 'chr2:2614:.:G:A'] },
                { assert summary.contains('records_dropped_overlap\t1') },
                { assert summary.contains('records_dropped_symbolic\t0') },
                // the dropped record is accounted for in step 6, and every check is ok
                { assert accounting.any { line -> line.contains('\tharmonization\tremoved\toverlap_allele\t1\t') } },
                { assert path(workflow.out.checks[0][1]).readLines().drop(1).every { line -> line.endsWith('\tok') } }
            )
        }
    }
}
