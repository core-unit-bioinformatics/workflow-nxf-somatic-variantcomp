/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    // Local checkout of the test-data repo next to the workflow repo; override with
    // NFT_TESTDATA=/path/to/workflow-nxf-somatic-variantcomp-testdata/
    pipelines_testdata_base_path = System.getenv('NFT_TESTDATA') ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/"
}

// Share conda environments between tests (every test has its own work directory)
conda.cacheDir = System.getenv('NFT_CONDA_CACHE') ?: "${projectDir}/.nf-test/conda"
// Activate the environments with micromamba (in envs/variantcomp-dev.yaml) if it is on PATH:
// `conda info` + `source activate` cost about 7 s per task on small machines (Raspberry Pi),
// micromamba well under a second. The environments themselves are the same (same hash).
// NFT_MICROMAMBA=false switches it off.
conda.useMicromamba = (System.getenv('NFT_MICROMAMBA') ?: 'true') == 'true' && ['bash', '-c', 'command -v micromamba'].execute().waitFor() == 0

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
