nextflow_pipeline {

    name "Test pipeline on the small SEQC2 dataset"
    script "../main.nf"
    tag "pipeline"
    tag "seqc2"
    profile "test_seqc2"

    test("-profile test_seqc2") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // MultiQC decides per run which tables it also exports as plot images: not stable;
            // datavzrd splits its data into many chunk files (report/tables/index.html is asserted)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots/**', 'report/tables/**'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def validated = path("$outputDir/pipeline_info/samplesheet.validated.csv").readLines()
            def annotatedLines = path("$outputDir/discordance/variants.annotated.tsv").readLines()
            def annotatedHeader = annotatedLines[0].tokenize('\t')
            def annotated = annotatedLines[1..-1].collect { line -> [annotatedHeader, line.split('\t', -1).toList()].transpose().collectEntries() }
            def callable = path("$outputDir/coverage/callable_summary.tsv").readLines()
            assert workflow.success
            assertAll(
                { assert validated.size() == 7 },
                { assert validated.count { line -> line.startsWith('SEQC2_') } == 6 },
                // every row has tumor and normal alignments (callable regions, read evidence)
                { assert validated.drop(1).every { line -> line.contains('_T.bam') && line.contains('_N.bam') } },
                { assert callable.size() == 4 },
                // input checks: every VCF and alignment checked at the start
                { assert file("$outputDir/input_checks/vcf").list().size() == 6 },
                { assert file("$outputDir/input_checks/alignments").list().size() == 12 },
                // annotation: VEP (GENCODE chr22 GTF), repeats, GIAB stratifications (--giab_<name>)
                { assert ['gene', 'consequence_group', 'in_repeat', 'giab_homopolymer', 'giab_tandem_repeat',
                          'giab_segmental_duplication', 'giab_low_mappability', 'giab_all_difficult'].every { c -> c in annotatedHeader } },
                // end-of-run checks: every count adds up; the reports were written
                { assert path("$outputDir/report/consistency_checks.tsv").readLines().drop(1).every { line -> line.endsWith('\tok') } },
                { assert path("$outputDir/multiqc/multiqc_report.html").text.contains('consistency checks passed') },
                { assert path("$outputDir/report/tables/index.html").exists() },
                { assert path("$outputDir/report/tables/multiqc-report/index_1.html").exists() },
                { assert path("$outputDir/report/variantcomp_report.zip").exists() },
                { assert path("$outputDir/main.html").text.contains("report/tables/multiqc-report/index_1.html") },
                // VEP --hgvs: protein changes in the annotated table
                { assert 'hgvsp' in annotatedHeader },
                // read evidence of indels (regression: the pileup found no alt read of called
                // indels): the 37-bp deletion called by both technologies has alt reads in
                // the wes tumor alignment; every TP has alt reads (evidence check)
                { assert annotated.find { r -> r.sample == 'SEQC2_NV_1' && r.pos == '23958385' && r.status == 'TP' }.other_tumor_alt.toInteger() > 0 },
                { assert path("$outputDir/report/consistency_checks.tsv").readLines().count { line -> line.startsWith('evidence\t') } >= 3 },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/variantcomp_software_mqc_versions.yml"),
                    stable_path,
                    stable_content
                ).match() }
            )
        }
    }
}
