nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            // MultiQC decides per run which tables it also exports as plot images: not stable;
            // datavzrd splits its data into many chunk files (report/tables/index.html is asserted)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots/**', 'report/tables/**'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // samplesheet.validated.csv holds absolute paths: check its structure instead of its content
            def validated = path("$outputDir/pipeline_info/samplesheet.validated.csv").readLines()
            def annotatedLines = path("$outputDir/discordance/variants.annotated.tsv").readLines()
            def annotatedHeader = annotatedLines[0].tokenize('\t')
            def annotated = annotatedLines[1..-1].collect { line -> [annotatedHeader, line.split('\t', -1).toList()].transpose().collectEntries() }
            def overallCounts = { metrics ->
                path(metrics).readLines().find { line -> line.contains('\toverall\tall\t') }.tokenize('\t')[5..8]
            }
            assert workflow.success
            assertAll(
                { assert validated.size() == 7 },
                { assert validated[0].startsWith('sample,technology,library_type') },
                // VCF headers contain bcftools command lines with dates: check records instead
                { assert path("$outputDir/vcf_preprocessed/S1/S1_wes.compare.vcf.gz").linesGzip.count { line -> !line.startsWith('#') } == 10 },
                { assert path("$outputDir/vcf_preprocessed/S1/S1_panel.compare.vcf.gz").linesGzip.count { line -> !line.startsWith('#') } == 9 },
                // benchmark counts as designed in design.tsv (tp_baseline, fn, tp_call, fp)
                { assert overallCounts("$outputDir/benchmark/S1/S1_wgs_vs_wes.metrics.tsv") == ['9', '1', '9', '1'] },
                { assert overallCounts("$outputDir/benchmark/S1/S1_wgs_vs_panel.metrics.tsv") == ['8', '2', '8', '1'] },
                { assert overallCounts("$outputDir/benchmark/S2/S2_wgs_vs_wes.metrics.tsv") == ['2', '1', '2', '1'] },
                { assert overallCounts("$outputDir/benchmark/S2/S2_wgs_vs_panel.metrics.tsv") == ['3', '0', '3', '1'] },
                // discordance: E08 called with a non-PASS FILTER in wes; E12 insertion in the tandem
                // repeat; genes assigned by VEP (synthetic GTF)
                { assert annotated.find { r -> r.query == 'wes' && r.pos == '4700' }.class == 'filtered_non_pass' },
                { assert annotated.find { r -> r.query == 'panel' && r.pos == '2999' }.tandem_repeat == 'yes' },
                { assert annotated.find { r -> r.query == 'panel' && r.pos == '4999' }.homopolymer == 'yes' },
                // GIAB stratifications (synthetic stand-ins): same overlap as the strata above
                { assert annotated.find { r -> r.query == 'panel' && r.pos == '4999' }.giab_homopolymer == 'yes' },
                { assert annotated.find { r -> r.query == 'panel' && r.pos == '2999' }.giab_tandem_repeat == 'yes' },
                { assert annotated.every { r -> r.gene.startsWith('GENE_') } },
                // known variants: E01 passes everywhere, E08 filtered in wes, E07 outside the region
                { assert path("$outputDir/known_variants/required_summary.tsv").readLines().contains('required_demo\tS1\twes\t3\t1\t2\t0.3333\tno') },
                { assert path("$outputDir/known_variants/required_summary.tsv").readLines().contains('required_demo\tall\twes\t3\t1\t2\t0.3333\tno') },
                // every step summary reaches MultiQC; the input checks ran for every VCF and BED
                { assert path("$outputDir/input_checks/vcf/S2_panel.vcf.reference_check.tsv").readLines().contains('renamed_contigs\t1->chr1,2->chr2') },
                { assert path("$outputDir/input_checks/vcf/S2_wes.vcf.reference_check.tsv").readLines().contains('records_on_mito\t1') },
                { assert path("$outputDir/known_variants/required_variants.tsv").text.contains('chr1\t4700\tG\tT\tFAIL_filtered') },
                // external truth = designed truth: wgs is perfect, wes/panel as against wgs
                { assert overallCounts("$outputDir/known_variants/benchmark/S1/S1_designed_truth_vs_wgs.metrics.tsv") == ['10', '0', '10', '0'] },
                { assert overallCounts("$outputDir/known_variants/benchmark/S1/S1_designed_truth_vs_panel.metrics.tsv") == ['8', '2', '8', '1'] },
                { assert validated.count { line -> line.contains(',wgs,wgs,') && line.contains(',true,') } == 2 },
                // end-of-run checks: every count adds up; the reports were written
                { assert path("$outputDir/report/consistency_checks.tsv").readLines().size() > 40 },
                { assert path("$outputDir/report/consistency_checks.tsv").readLines().drop(1).every { line -> line.endsWith('\tok') } },
                { assert path("$outputDir/multiqc/multiqc_report.html").text.contains('consistency checks passed') },
                { assert path("$outputDir/report/tables/index.html").exists() },
                { assert path("$outputDir/report/tables/multiqc-report/index_1.html").exists() },
                { assert path("$outputDir/report/variantcomp_report.zip").exists() },
                // accounting: E08 (non-PASS in wes) is removed in the PASS split
                { assert path("$outputDir/vcf_preprocessed/accounting/S1_wes.removed.tsv").text.contains('pass_split\tfilter_not_pass\tchr1\t4700') },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/variantcomp_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
