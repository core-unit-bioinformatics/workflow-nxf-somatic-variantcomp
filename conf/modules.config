/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: '.*VARIANTCOMP:CHECK_SAMPLESHEET' {
        // cross-row checks of the samplesheet; the truth technology must occur for every sample
        ext.args   = { "--truth-technology ${params.truth_technology}" }
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*.validated.csv'
        ]
    }

    withName: '.*:CHECK_(STRATIFICATION|KNOWN)' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*.validated.csv'
        ]
    }

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPARE_REFERENCE:GAWK_GENOME_BED' {
        // one BED interval per reference contig: name, 0, length (from the .fai)
        ext.args2  = '\'BEGIN { OFS = "\\t" } { print $1, 0, $2 }\''
        ext.prefix = 'genome'
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPARE_REGIONS:CHECK_REFERENCE_BED' {
        publishDir = [
            path: { "${params.outdir}/regions/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*PREPARE_REGIONS:BEDTOOLS_SORT' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/regions/targets" },
            mode: params.publish_dir_mode,
            pattern: '*.bed',
            saveAs: { filename -> meta.role == 'target' ? filename : null }
        ]
    }

    withName: '.*BED_INTERSECT_ALL:BEDTOOLS_MULTIINTER' {
        ext.prefix = { "${meta.id}.multiinter" }
        publishDir = [ enabled: false ]
    }

    withName: '.*BED_INTERSECT_ALL:GAWK_ALL' {
        // multiinter columns: chrom, start, end, number of BEDs, list, one 0/1 column per BED;
        // NF - 5 is the number of BEDs, so $4 == NF - 5 keeps intervals covered by all BEDs
        ext.args2  = '\'BEGIN { FS = OFS = "\\t" } $4 == NF - 5 { print $1, $2, $3 }\''
        ext.prefix = { "${meta.id}.all" }
        publishDir = [ enabled: false ]
    }

    withName: '.*BED_INTERSECT_ALL:BEDTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.merged" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPARE_REGIONS:BEDTOOLS_(INTERSECT_REGIONS|SUBTRACT)' {
        ext.prefix = { "${meta.id}.${task.process.tokenize(':')[-1].toLowerCase()}" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPARE_REGIONS:BEDTOOLS_INTERSECT_REGIONS' {
        // -sorted (with the .fai as genome file): output stays in reference order for bedtools merge
        ext.args   = '-sorted'
    }

    withName: '.*PREPARE_REGIONS:BEDTOOLS_MERGE_COMMON' {
        ext.prefix = 'common_targets'
        publishDir = [
            path: { "${params.outdir}/regions" },
            mode: params.publish_dir_mode,
            pattern: 'common_targets.bed'
        ]
    }

    withName: '.*PREPARE_REGIONS:REGION_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/regions" },
            mode: params.publish_dir_mode,
            pattern: '*.summary.tsv'
        ]
    }

    //
    // Coverage (see subworkflows/local/coverage)
    //
    withName: '.*COVERAGE:SAMTOOLS_IDXSTATS' {
        publishDir = [ enabled: false ]
    }

    withName: '.*COVERAGE:CHECK_REFERENCE_BAM' {
        publishDir = [
            path: { "${params.outdir}/coverage/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*COVERAGE:MOSDEPTH' {
        // --quantize 0:<min>: -> bins LOW_COVERAGE (depth < min) and CALLABLE (depth >= min);
        // --no-per-base: per-base output is not needed;
        // amplicon libraries: --flag 772 keeps duplicate-flagged reads (default 1796 removes them)
        ext.args   = { "--quantize 0:${params.min_coverage}: --no-per-base" + (meta.library_type == 'amplicon' ? ' --flag 772' : '') }
        publishDir = [
            path: { "${params.outdir}/coverage/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.{txt,bed.gz,csi}'
        ]
    }

    withName: '.*COVERAGE:MOSDEPTH_CALLABLE' {
        // base mode: CALLABLE bins of --quantize; region mode: mean depth per region >= --min_coverage
        ext.args   = { "--mode ${params.callable_mode} --min-coverage ${params.min_coverage}" }
        publishDir = [ enabled: false ]
    }

    withName: '.*COVERAGE:BEDTOOLS_SORT_CALLABLE' {
        ext.prefix = { "${meta.id}.callable.sorted" }
        publishDir = [ enabled: false ]
    }

    withName: '.*COVERAGE:BEDTOOLS_INTERSECT_COMMON' {
        // callable bases of the sample inside the common region; -sorted (with the .fai as
        // genome file) keeps the output in reference order (plain intersect does not when an
        // interval overlaps several intervals of the other BED)
        ext.args   = '-sorted'
        ext.prefix = { "${meta.id}.callable" }
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: params.publish_dir_mode,
            pattern: '*.callable.bed'
        ]
    }

    withName: '.*COVERAGE:REGION_SUMMARY_CALLABLE' {
        // settings are written into the summary table for traceability
        ext.args   = { "--sample ${meta.sample} --alignments ${meta.alignments} --mode ${params.callable_mode} --min-coverage ${params.min_coverage}" }
        ext.prefix = { "${meta.id}.callable" }
        publishDir = [ enabled: false ]
    }

    //
    // VCF preprocessing (see subworkflows/local/preprocess_vcf)
    //
    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_HEADER' {
        // header only: contig lines and sample names for the reference check
        ext.args   = '--header-only --no-version'
        ext.prefix = { "${meta.id}.header" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_QUERY_CONTIGS' {
        // contig of every record (counted by check_reference.py)
        ext.args   = "--format '%CHROM\\n'"
        ext.prefix = { "${meta.id}.record_contigs" }
        ext.suffix = 'txt'
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:CHECK_REFERENCE_VCF' {
        // the tumor/normal sample columns of the samplesheet must exist in the VCF
        ext.args   = { "--samples ${[meta.tumor_id, meta.normal_id].findAll { id -> id }.join(',')}" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*PREPROCESS_VCF:CHECK_REF_ALLELES' {
        // stop if the fraction of REF mismatches (bcftools norm --check-ref x) is above --max_ref_mismatch
        ext.args   = { "--max-ref-mismatch ${params.max_ref_mismatch}" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.ref_alleles.tsv'
        ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_SELECT' {
        // tumor first, then normal; --no-update keeps INFO/AC/AN as written by the caller; BGZF output + index
        ext.args   = { "--samples ${[meta.tumor_id, meta.normal_id].findAll { id -> id }.join(',')} --no-update --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}.select" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_ANNOTATE' {
        // the rename map (--rename-chrs) is passed by the module; BGZF output + index
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.renamed" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_CLEAN' {
        // drop gVCF reference blocks (only ALT is <NON_REF> or <*>); records with a real ALT plus <NON_REF> are kept and split later
        ext.args   = "--exclude 'N_ALT==1 && (ALT=\"<NON_REF>\" || ALT=\"<*>\")' --no-update --output-type z --write-index=tbi"
        ext.prefix = { "${meta.id}.clean" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_REHEADER' {
        // contig lines are replaced from the .fai (fixes lengths, adds missing contigs)
        ext.args2  = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.reheader" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_NORM' {
        // split multiallelic records, left-align (needs --fasta-ref, given by the module),
        // atomize MNVs into SNVs, remove records whose REF differs from the reference
        // (counted in the log and checked by CHECK_REF_ALLELES), remove exact duplicates
        ext.args   = '--multiallelics -any --atomize --check-ref x --rm-dup exact --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.norm" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.norm.log'
        ]
    }

    withName: '.*PREPROCESS_VCF:HARMONIZE_VCF' {
        // every tumor record needs a VAF; raise e.g. '--max-missing-vaf 0.01' to allow a few without
        ext.args   = '--max-missing-vaf 0'
        ext.prefix = { "${meta.id}.normalized" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.{normalized.vcf.gz,normalized.vcf.gz.tbi,harmonize_summary.tsv}'
        ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_COMPARE' {
        ext.args   = {
            def conditions = []
            if (params.min_vaf > 0)       { conditions << "INFO/VC_T_VAF>=${params.min_vaf}" }
            if (params.min_depth > 0)     { conditions << "INFO/VC_T_DP>=${params.min_depth}" }
            if (params.min_alt_reads > 0) { conditions << "INFO/VC_T_ALT>=${params.min_alt_reads}" }
            [
                params.filter_pass_only ? '--apply-filters PASS,.' : '',
                conditions ? "--include '${conditions.join(' && ')}'" : '',
                '--targets-overlap record --no-update --output-type z --write-index=tbi'
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.compare" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.compare.vcf.gz{,.tbi}'
        ]
    }

    //
    // Benchmark (see subworkflows/local/benchmark)
    //
    withName: '.*BENCHMARK:RTGTOOLS_FORMAT' {
        publishDir = [ enabled: false ]
    }

    withName: '.*BENCHMARK:RTGTOOLS_VCFEVAL' {
        // every record of the compared VCFs is a call (filters are already applied);
        // tumor VAF as score gives recall/precision curves over VAF thresholds
        ext.args   = { "--squash-ploidy --all-records --decompose --sample ${meta.truth_tumor},${meta.query_tumor} --vcf-score-field INFO.VC_T_VAF" }
        publishDir = [
            path: { "${params.outdir}/benchmark/${meta.sample}/vcfeval" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf.gz,vcf.gz.tbi,tsv.gz,txt}'
        ]
    }

    withName: '.*BENCHMARK:BCFTOOLS_ISEC_EXACT' {
        // records with the same CHROM, POS, REF and ALT
        ext.args   = '--collapse none'
        ext.prefix = { "${meta.id}.isec_exact" }
        publishDir = [ enabled: false ]
    }

    withName: '.*BENCHMARK:BCFTOOLS_ISEC_POSITION' {
        // records with the same CHROM and POS, whatever the alleles
        ext.args   = '--collapse all'
        ext.prefix = { "${meta.id}.isec_position" }
        publishDir = [ enabled: false ]
    }

    withName: '.*BENCHMARK:BENCHMARK_METRICS' {
        // VAF bin edges for the truth_vaf / query_vaf strata
        ext.args   = { "--vaf-bins ${params.vaf_bins}" }
        publishDir = [
            path: { "${params.outdir}/benchmark/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: '.*BENCHMARK:AGGREGATE_METRICS' {
        publishDir = [
            path: { "${params.outdir}/benchmark" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    //
    // Discordance (see subworkflows/local/discordance)
    //
    withName: '.*DISCORDANCE:CHECK_REFERENCE_ANNOTATION' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/discordance/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*DISCORDANCE:BCFTOOLS_QUERY_SITES' {
        // position of every variant: CHROM<TAB>POS (targets file of bcftools mpileup)
        ext.args   = "--format '%CHROM\\t%POS\\n'"
        ext.prefix = { "${meta.id}.sites" }
        ext.suffix = 'tsv'
        publishDir = [ enabled: false ]
    }

    withName: '.*DISCORDANCE:BCFTOOLS_MPILEUP' {
        // mpileup: allele depths (FORMAT/AD, FORMAT/DP) up to depth 100000, reads with
        // mapping quality >= 20 and bases with quality >= 13; amplicon libraries keep
        // duplicate-flagged reads (--ff without DUP)
        ext.args   = { '--annotate FORMAT/AD,FORMAT/DP --max-depth 100000 --min-MQ 20 --min-BQ 13' + (meta.library_type == 'amplicon' ? ' --ff UNMAP,SECONDARY,QCFAIL' : '') }
        // call: multiallelic caller, keep all alleles, report every site (no --variants-only),
        // so that FORMAT/AD is available at every requested position
        ext.args2  = '--multiallelic-caller --keep-alts'
        ext.args3  = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.pileup" }
        publishDir = [ enabled: false ]
    }

    withName: '.*DISCORDANCE:BCFTOOLS_NORM_EVIDENCE' {
        // split and left-align like the calls (no REF check: the pileup REF is the reference)
        ext.args   = '--multiallelics -any --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.evidence" }
        publishDir = [
            path: { "${params.outdir}/discordance/${meta.sample}/evidence" },
            mode: params.publish_dir_mode,
            pattern: '*.evidence.vcf.gz{,.tbi}'
        ]
    }

    withName: '.*DISCORDANCE:CLASSIFY_DISCORDANCE' {
        // thresholds of the discordance classes and the detection-power model (see docs/output.md)
        ext.args   = { "--min-coverage ${params.min_coverage} --min-alt-reads ${params.evidence_min_alt_reads} --germline-vaf ${params.germline_vaf} --power-min-alt ${params.power_min_alt_reads} --detection-power ${params.detection_power}" }
        publishDir = [
            path: { "${params.outdir}/discordance/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: '.*DISCORDANCE:AGGREGATE_POWER' {
        publishDir = [
            path: { "${params.outdir}/benchmark" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: '.*DISCORDANCE:VARIANTS_TO_BED' {
        publishDir = [ enabled: false ]
    }

    withName: '.*DISCORDANCE:BEDTOOLS_SORT_ANNOTATION' {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [ enabled: false ]
    }

    withName: '.*DISCORDANCE:BEDTOOLS_MAP_GENES' {
        // gene names (column 4 of the gene BED) of all genes overlapping a variant
        ext.args   = '-c 4 -o distinct'
        ext.prefix = { "${meta.id}.genes" }
        publishDir = [ enabled: false ]
    }

    withName: '.*DISCORDANCE:BEDTOOLS_INTERSECT_STRATA' {
        // -c: number of stratification intervals overlapping each variant
        ext.args   = '-c'
        ext.prefix = { "${meta.id}.counts" }
        publishDir = [ enabled: false ]
    }

    withName: '.*DISCORDANCE:ANNOTATION_MERGE' {
        publishDir = [
            path: { "${params.outdir}/discordance" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    //
    // Known variants (see subworkflows/local/prepare_known_variants and known_variants)
    //
    withName: '.*PREPARE_KNOWN_VARIANTS:KNOWN_PREPARE' {
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPARE_KNOWN_VARIANTS:CHECK_REF_ALLELES_KNOWN' {
        // a known variant whose REF differs from the reference is an error (threshold 0)
        ext.args   = '--max-ref-mismatch 0'
        publishDir = [
            path: { "${params.outdir}/known_variants/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.ref_alleles.tsv'
        ]
    }

    withName: '.*PREPARE_KNOWN_VARIANTS:KNOWN_NORM' {
        // like the calls: split, left-align, atomize, remove (and count) REF mismatches, deduplicate
        ext.args   = '--multiallelics -any --atomize --check-ref x --rm-dup exact --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.known.normalized" }
        publishDir = [
            path: { "${params.outdir}/known_variants/lists" },
            mode: params.publish_dir_mode,
            pattern: '*.vcf.gz{,.tbi}'
        ]
    }

    withName: '.*PREPARE_KNOWN_VARIANTS:CHECK_REFERENCE_KNOWN' {
        ext.prefix = { "${meta.id}.regions" }
        publishDir = [
            path: { "${params.outdir}/known_variants/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*KNOWN_VARIANTS:KNOWN_CHECK' {
        publishDir = [
            path: { "${params.outdir}/known_variants/required/${meta.name}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: '.*KNOWN_VARIANTS:KNOWN_VCFEVAL' {
        // truth set is sites-only: the pseudo-sample ALT is used for the baseline
        ext.args   = { "--squash-ploidy --all-records --decompose --sample ALT,${meta.query_tumor} --vcf-score-field INFO.VC_T_VAF" }
        publishDir = [
            path: { "${params.outdir}/known_variants/benchmark/${meta.sample}/vcfeval" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf.gz,vcf.gz.tbi,tsv.gz,txt}'
        ]
    }

    withName: '.*KNOWN_VARIANTS:KNOWN_ISEC_EXACT' {
        // exact match: same CHROM, POS, REF and ALT
        ext.args   = '--collapse none'
        ext.prefix = { "${meta.id}.isec_exact" }
        publishDir = [ enabled: false ]
    }

    withName: '.*KNOWN_VARIANTS:KNOWN_ISEC_POSITION' {
        // position match: same CHROM and POS, any allele
        ext.args   = '--collapse all'
        ext.prefix = { "${meta.id}.isec_position" }
        publishDir = [ enabled: false ]
    }

    withName: '.*KNOWN_VARIANTS:KNOWN_SUMMARY' {
        // --fail_on_missing_required stops the pipeline after writing the summary
        ext.args   = { params.fail_on_missing_required ? '--fail-on-missing' : '' }
        publishDir = [
            path: { "${params.outdir}/known_variants" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv',
            // known.required_variants.tsv -> required_variants.tsv; the MultiQC file is not published
            saveAs: { filename -> filename.endsWith('_mqc.tsv') ? null : filename.replaceFirst(/^known\./, '') }
        ]
    }

    withName: '.*KNOWN_VARIANTS:KNOWN_METRICS' {
        // VAF bin edges for the truth_vaf / query_vaf strata
        ext.args   = { "--vaf-bins ${params.vaf_bins}" }
        publishDir = [
            path: { "${params.outdir}/known_variants/benchmark/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: '.*KNOWN_VARIANTS:KNOWN_AGGREGATE' {
        publishDir = [
            path: { "${params.outdir}/known_variants/benchmark" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    //
    // Report
    //
    withName: 'VARIANTCOMP_REPORT' {
        // VAF threshold of the low-VAF enrichment feature
        ext.args   = { "--low-vaf ${params.low_vaf}" }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            pattern: '{*.tsv,plots/*.png}',
            saveAs: { filename -> filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'GUNZIP' {
        publishDir = [ enabled: false ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
