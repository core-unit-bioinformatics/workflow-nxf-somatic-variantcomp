/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPARE_REGIONS:CHECK_REFERENCE_BED' {
        ext.args   = { "--max-ref-mismatch ${params.max_ref_mismatch}" }
        publishDir = [
            path: { "${params.outdir}/regions/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*PREPARE_REGIONS:BEDTOOLS_SORT' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/regions/targets" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }

    withName: '.*PREPARE_REGIONS:COMMON_REGIONS' {
        publishDir = [
            path: { "${params.outdir}/regions" },
            mode: params.publish_dir_mode,
            pattern: 'common_targets.*'
        ]
    }

    //
    // VCF preprocessing (see subworkflows/local/preprocess_vcf)
    //
    withName: '.*PREPROCESS_VCF:CHECK_REFERENCE_VCF' {
        ext.args   = { "--max-ref-mismatch ${params.max_ref_mismatch} --samples ${[meta.tumor_id, meta.normal_id].findAll { id -> id }.join(',')}" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_SELECT' {
        ext.args   = { "--samples ${[meta.tumor_id, meta.normal_id].findAll { id -> id }.join(',')} --no-update --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}.select" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_ANNOTATE' {
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.renamed" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_CLEAN' {
        ext.args   = "--exclude 'N_ALT==1 && (ALT=\"<NON_REF>\" || ALT=\"<*>\")' --no-update --output-type z --write-index=tbi"
        ext.prefix = { "${meta.id}.clean" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_REHEADER' {
        ext.args2  = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.reheader" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_NORM' {
        ext.args   = '--multiallelics -any --atomize --check-ref x --rm-dup exact --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.norm" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:HARMONIZE_VCF' {
        ext.prefix = { "${meta.id}.normalized" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.normalized.vcf.gz{,.tbi}'
        ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_COMPARE' {
        ext.args   = {
            def conditions = []
            if (params.min_vaf > 0)       { conditions << "INFO/VC_T_VAF>=${params.min_vaf}" }
            if (params.min_depth > 0)     { conditions << "INFO/VC_T_DP>=${params.min_depth}" }
            if (params.min_alt_reads > 0) { conditions << "INFO/VC_T_ALT>=${params.min_alt_reads}" }
            [
                params.filter_pass_only ? '--apply-filters PASS,.' : '',
                conditions ? "--include '${conditions.join(' && ')}'" : '',
                '--targets-overlap record --no-update --output-type z --write-index=tbi'
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.compare" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.compare.vcf.gz{,.tbi}'
        ]
    }

    withName: 'GUNZIP' {
        publishDir = [ enabled: false ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
