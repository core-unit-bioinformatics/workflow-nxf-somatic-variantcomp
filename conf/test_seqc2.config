/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the small SEQC2 test (T1)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SEQC2 HCC1395/HCC1395BL WES + WGS, chr22 only, 3 pseudo-samples, BAM slices for one.
    Prepared by tests/seqc2/seqc2_testdata.py (prepare --mode small) into the test-data
    repo. Runs on a laptop / Raspberry Pi.

    Use as follows:
        nextflow run core-unit-bioinformatics/workflow-nxf-somatic-variantcomp -profile test_seqc2,<conda/docker/singularity> --outdir <OUTDIR>
    or
        tests/seqc2/seqc2_testdata.py run --mode small

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '3.GB',
        time: '4.h'
    ]
}

// rtg-tools' wrapper only accepts x86_64/arm64 machines; for local conda tests on aarch64 Linux
// (e.g. a Raspberry Pi) it is told 'arm64'. Memory is limited for small test machines.
process {
    withName: 'RTGTOOLS_.*' {
        memory       = '1.GB'
        beforeScript = System.getProperty('os.arch') == 'aarch64' ? 'uname() { if [ "$1" = "-m" ]; then echo arm64; else command uname "$@"; fi; }; export -f uname' : ''
    }
}

params {
    config_profile_name        = 'SEQC2 small test profile'
    config_profile_description = 'SEQC2 HCC1395 WES + WGS, chr22, 3 pseudo-samples'

    // test data: --pipelines_testdata_base_path, else a checkout next to the workflow repo
    input            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/samplesheet.csv'
    fasta            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/reference/GRCh38.d1.vd1_chr22.fa.gz'
    truth_technology = 'wgs'
    gene_bed         = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/annotation/genes.bed'
    stratification   = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/stratification.csv'
    known_variants   = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/known_variants.csv'
}
