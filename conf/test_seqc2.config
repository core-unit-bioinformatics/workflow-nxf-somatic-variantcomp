/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the small SEQC2 test (T1)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SEQC2 HCC1395/HCC1395BL WES + WGS, chr22 only, 3 pseudo-samples with BAM slices.
    Prepared with seqc2-toolkit (datasets/variantcomp_small.yaml, profile variantcomp) into
    the test-data repo. Runs on a laptop / Raspberry Pi.

    Use as follows:
        nextflow run core-unit-bioinformatics/workflow-nxf-somatic-variantcomp -profile test_seqc2,<conda/docker/singularity> --outdir <OUTDIR>
    or
        seqc2 run datasets/variantcomp_small.yaml --profile variantcomp --pipeline <PIPELINE_DIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '3.GB',
        time: '4.h'
    ]

    // the test data are tiny (peak memory of any task about 400 MB): small requests, so
    // that the local executor runs tasks in parallel. The default labels ask for 6 GB,
    // which the limit above caps to the whole machine, i.e. one task at a time.
    withLabel: 'process_single|process_low' {
        cpus   = 1
        memory = '768.MB'
    }
    withLabel: 'process_medium|process_high' {
        cpus   = 2
        memory = '1.GB'
    }
}

// rtg-tools' wrapper only accepts x86_64/arm64 machines; for local conda tests on aarch64 Linux
// (e.g. a Raspberry Pi) it is told 'arm64'. Memory is limited for small test machines.
process {
    withName: 'RTGTOOLS_.*' {
        memory       = '1.GB'
        beforeScript = System.getProperty('os.arch') == 'aarch64' ? 'uname() { if [ "$1" = "-m" ]; then echo arm64; else command uname "$@"; fi; }; export -f uname' : ''
    }
}

params {
    config_profile_name        = 'SEQC2 small test profile'
    config_profile_description = 'SEQC2 HCC1395 WES + WGS, chr22, 3 pseudo-samples'

    // test data: --pipelines_testdata_base_path, else a checkout next to the workflow repo
    input            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/variantcomp/samplesheet.csv'
    fasta            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/reference/GRCh38.d1.vd1_chr22.fa.gz'
    truth_technology = 'wgs'
    vep_gtf          = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/annotation/gencode.v46.basic.annotation.gtf.gz'
    // GIAB v3.5 stratifications (chr22 subset, release layout)
    giab_homopolymer           = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/annotation/giab/GRCh38/LowComplexity/GRCh38_AllHomopolymers_ge7bp_imperfectge11bp_slop5.bed.gz'
    giab_tandem_repeat         = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/annotation/giab/GRCh38/LowComplexity/GRCh38_AllTandemRepeats.bed.gz'
    giab_segmental_duplication = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/annotation/giab/GRCh38/SegmentalDuplications/GRCh38_segdups.bed.gz'
    giab_low_mappability       = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/annotation/giab/GRCh38/Mappability/GRCh38_lowmappabilityall.bed.gz'
    giab_all_difficult         = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/annotation/giab/GRCh38/Union/GRCh38_alldifficultregions.bed.gz'
    known_variants   = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/small/variantcomp/known_variants.csv'
}
