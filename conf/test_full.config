/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the full SEQC2 test (T2, HPC)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SEQC2 HCC1395/HCC1395BL WES + WGS, genome-wide, first replicate of every center that
    sequenced both. Prepare the data first with seqc2-toolkit (several GB of downloads):

        seqc2 fetch datasets/variantcomp_full.yaml --outdir <BASE>/seqc2/full
        seqc2 samplesheet datasets/variantcomp_full.yaml --outdir <BASE>/seqc2/full --profile variantcomp

    Then run with --pipelines_testdata_base_path <BASE>/, or let the toolkit run it:

        seqc2 run datasets/variantcomp_full.yaml --outdir <BASE>/seqc2/full --profile variantcomp \
            --pipeline <PIPELINE_DIR> --nf-profile test_full,singularity

    Use as follows:
        nextflow run core-unit-bioinformatics/workflow-nxf-somatic-variantcomp -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'SEQC2 HCC1395 WES + WGS, genome-wide, 12 pseudo-samples'

    input            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/variantcomp/samplesheet.csv'
    truth_technology = 'wgs'
    // the full dataset has no alignments by default (datasets/variantcomp_full.yaml of
    // seqc2-toolkit; set data.bam: true there and both params to true to use them)
    callable_regions = false
    read_evidence    = false
    // annotation resources prepared by seqc2-toolkit (GENCODE GTF, GIAB v3.5)
    fasta            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/reference/GRCh38.d1.vd1.fa'
    vep_gtf          = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/annotation/gencode.v46.basic.annotation.gtf.gz'
    giab_homopolymer           = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/annotation/giab/GRCh38/LowComplexity/GRCh38_AllHomopolymers_ge7bp_imperfectge11bp_slop5.bed.gz'
    giab_tandem_repeat         = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/annotation/giab/GRCh38/LowComplexity/GRCh38_AllTandemRepeats.bed.gz'
    giab_segmental_duplication = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/annotation/giab/GRCh38/SegmentalDuplications/GRCh38_segdups.bed.gz'
    giab_low_mappability       = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/annotation/giab/GRCh38/Mappability/GRCh38_lowmappabilityall.bed.gz'
    giab_all_difficult         = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/annotation/giab/GRCh38/Union/GRCh38_alldifficultregions.bed.gz'
    known_variants   = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'seqc2/full/variantcomp/known_variants.csv'
}
