/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Synthetic edge-case dataset (2 samples x 3 technologies) from the test-data repo,
    created by tests/synthetic/make_synthetic_data.py.

    Use as follows:
        nextflow run core-unit-bioinformatics/workflow-nxf-somatic-variantcomp -profile test,<conda/docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '3.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic edge-case dataset to check pipeline function'

    // Input data
    // test data: --pipelines_testdata_base_path, else a checkout next to the workflow repo
    input            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'synthetic/samplesheet.tsv'
    truth_technology = 'wgs'
}
