/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Synthetic edge-case dataset (2 samples x 3 technologies) from the test-data repo,
    created by tests/synthetic/make_synthetic_data.py.

    Use as follows:
        nextflow run core-unit-bioinformatics/workflow-nxf-somatic-variantcomp -profile test,<conda/docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '3.GB',
        time: '1.h'
    ]

    // the test data are tiny (peak memory of any task about 400 MB): small requests, so
    // that the local executor runs tasks in parallel. The default labels ask for 6 GB,
    // which the limit above caps to the whole machine, i.e. one task at a time.
    withLabel: 'process_single|process_low' {
        cpus   = 1
        memory = '768.MB'
    }
    withLabel: 'process_medium|process_high' {
        cpus   = 2
        memory = '1.GB'
    }
}

// rtg-tools' wrapper only accepts x86_64/arm64 machines; for local conda tests on aarch64 Linux
// (e.g. a Raspberry Pi) it is told 'arm64'. Memory is limited for small test machines.
process {
    withName: 'RTGTOOLS_.*' {
        memory       = '1.GB'
        beforeScript = System.getProperty('os.arch') == 'aarch64' ? 'uname() { if [ "$1" = "-m" ]; then echo arm64; else command uname "$@"; fi; }; export -f uname' : ''
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic edge-case dataset to check pipeline function'

    // Input data
    // test data: --pipelines_testdata_base_path, else a checkout next to the workflow repo
    // the synthetic data have no alignments
    callable_regions = false
    read_evidence    = false
    // the synthetic genome is small: the common region has about 7 kb
    min_region_bp    = 1000
    input            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'synthetic/samplesheet.csv'
    fasta            = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'synthetic/reference/synthetic.fa'
    truth_technology = 'wgs'
    vep_gtf          = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'synthetic/annotation/genes.gtf.gz'
    stratification   = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'synthetic/stratification.csv'
    // GIAB-style stratifications: the synthetic stratification BEDs stand in for two GIAB
    // files (columns giab_homopolymer, giab_tandem_repeat); the others are not set
    giab_homopolymer   = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'synthetic/bed/stratification_homopolymer.bed'
    giab_tandem_repeat = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'synthetic/bed/stratification_tandem_repeat.bed'
    known_variants   = (params.pipelines_testdata_base_path ?: "${projectDir}/../workflow-nxf-somatic-variantcomp-testdata/") + 'synthetic/known_variants.csv'
}
