/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Benchmark (subworkflows/local/benchmark)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*BENCHMARK:RTGTOOLS_FORMAT' {
        publishDir = [ enabled: false ]
    }

    withName: '.*BENCHMARK:RTGTOOLS_VCFEVAL' {
        // every record of the compared VCFs is a call (filters are already applied);
        // tumor VAF as score gives recall/precision curves over VAF thresholds
        ext.args   = { "--squash-ploidy --all-records --decompose --sample ${meta.truth_tumor},${meta.query_tumor} --vcf-score-field INFO.VC_T_VAF" }
        publishDir = [
            path: { "${params.outdir}/benchmark/rtgtools_vcfeval/${meta.sample}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf.gz,vcf.gz.tbi,tsv.gz,txt}'
        ]
    }

    withName: '.*BENCHMARK:BCFTOOLS_ISEC_EXACT' {
        // records with the same CHROM, POS, REF and ALT
        ext.args   = '--collapse none'
        ext.prefix = { "${meta.id}" }
        // folder <pair>: sites.txt (CHROM POS REF ALT flags truth/query), 0000.vcf.gz
        // (truth only), 0001.vcf.gz (query only), 0002/0003.vcf.gz (in both)
        publishDir = [
            path: { "${params.outdir}/benchmark/bcftools_isec_exact/${meta.sample}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*BENCHMARK:BCFTOOLS_ISEC_POSITION' {
        // records with the same CHROM and POS, whatever the alleles
        ext.args   = '--collapse all'
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/benchmark/bcftools_isec_position/${meta.sample}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*BENCHMARK:BENCHMARK_METRICS' {
        // VAF bin edges for the truth_vaf / query_vaf strata
        ext.args   = { "--vaf-bins ${params.vaf_bins}" }
        // per pair: <pair>.metrics.tsv (all methods) and <pair>.variants.tsv (status of
        // every variant with vcfeval and with both isec methods)
        publishDir = [
            path: { "${params.outdir}/benchmark/metrics/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: '.*BENCHMARK:AGGREGATE_METRICS' {
        // metrics.per_pair/aggregated.tsv (all methods, column method) and one pair of
        // files per method: metrics.<rtgtools_vcfeval|bcftools_isec_exact|
        // bcftools_isec_position>.per_pair/aggregated.tsv
        publishDir = [
            path: { "${params.outdir}/benchmark/metrics" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }
}
