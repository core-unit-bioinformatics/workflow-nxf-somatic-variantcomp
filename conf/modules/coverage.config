/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Coverage and callable regions (subworkflows/local/coverage)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*COVERAGE:MOSDEPTH(_TARGETS)?' {
        // resources of both mosdepth runs (instead of process_medium: 6 cpus, 36 GB):
        // mosdepth uses its threads only for BAM/CRAM decompression, and its authors
        // recommend 4 or fewer; memory is about one 32-bit counter per base of the largest
        // contig (chr1: ~1 GB) plus the region/threshold tables. Smaller requests let the
        // scheduler run more mosdepth jobs at the same time; the output does not change.
        // A task killed for memory (exit 137-140) is retried with twice the memory (base.config)
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }

    withName: '.*COVERAGE:RENAME_BED' {
        // the common region in the alignment's contig names (for mosdepth --by)
        ext.prefix = { "${meta.id}.common" }
        publishDir = [ enabled: false ]
    }

    withName: '.*COVERAGE:RENAME_TARGET' {
        // the target BED of the alignment's technology, in the alignment's contig names
        ext.prefix = { "${meta.id}.target" }
        publishDir = [ enabled: false ]
    }

    withName: '.*COVERAGE:MOSDEPTH_TARGETS' {
        // coverage in the target BED: mean depth per target and bases >= each threshold;
        // amplicon libraries keep duplicate-flagged reads (as in the callable run)
        ext.args   = { "--thresholds ${params.coverage_thresholds} --no-per-base" + (meta.library_type == 'amplicon' && params.amplicon_keep_duplicates ? ' --flag 772' : '') }
        ext.prefix = { "${meta.id}.target" }
        publishDir = [
            path: { "${params.outdir}/coverage/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.{txt,bed.gz,csi}'
        ]
    }

    withName: '.*COVERAGE:COVERAGE_SUMMARY' {
        ext.args   = { "--thresholds ${params.coverage_thresholds}" }
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: params.publish_dir_mode,
            pattern: '*.coverage.tsv'
        ]
    }

    withName: '.*COVERAGE:MOSDEPTH' {
        // --quantize 0:<min>: -> bins LOW_COVERAGE (depth < min) and CALLABLE (depth >= min);
        // --no-per-base: per-base output is not needed;
        // amplicon libraries: --flag 772 keeps duplicate-flagged reads (default 1796 removes them)
        // the threshold depends on the alignment: tumor or normal
        // --thresholds: bases >= each depth per common-region interval (coverage summary)
        ext.args   = { "--quantize 0:${meta.role == 'normal' ? params.min_coverage_normal : params.min_coverage_tumor}: --thresholds ${params.coverage_thresholds} --no-per-base" + (meta.library_type == 'amplicon' && params.amplicon_keep_duplicates ? ' --flag 772' : '') }
        publishDir = [
            path: { "${params.outdir}/coverage/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.{txt,bed.gz,csi}'
        ]
    }

    withName: '.*COVERAGE:MOSDEPTH_CALLABLE' {
        // base mode: CALLABLE bins of --quantize; region mode: mean depth per region >= the
        // threshold of the alignment (tumor: --min_coverage_tumor, normal: --min_coverage_normal)
        ext.args   = { "--mode ${params.callable_mode} --min-coverage ${meta.role == 'normal' ? params.min_coverage_normal : params.min_coverage_tumor}" }
        publishDir = [ enabled: false ]
    }

    withName: '.*COVERAGE:BEDTOOLS_INTERSECT_COMMON' {
        // callable bases of the sample inside the common region; -sorted (with the .fai as
        // genome file) keeps the output in reference order (plain intersect does not when an
        // interval overlaps several intervals of the other BED)
        ext.args   = '-sorted'
        ext.prefix = { "${meta.id}.callable" }
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: params.publish_dir_mode,
            pattern: '*.callable.bed'
        ]
    }

    withName: '.*COVERAGE:REGION_SUMMARY_CALLABLE' {
        // settings are written into the summary table for traceability
        ext.args   = { "--sample ${meta.sample} --alignments ${meta.alignments} --mode ${params.callable_mode} --min-coverage ${params.min_coverage_tumor}/${params.min_coverage_normal} --min-bp ${params.min_region_bp}" }
        ext.prefix = { "${meta.id}.callable" }
        publishDir = [ enabled: false ]
    }
}
