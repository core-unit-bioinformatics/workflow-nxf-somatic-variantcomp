/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Discordance (subworkflows/local/discordance)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*DISCORDANCE:BCFTOOLS_QUERY_SITES' {
        // alleles of every variant: CHROM<TAB>POS<TAB>REF<TAB>ALT (sites of read_evidence.py;
        // the compared VCFs have one ALT per record)
        ext.args   = "--format '%CHROM\\t%POS\\t%REF\\t%ALT\\n'"
        ext.prefix = { "${meta.id}.sites" }
        ext.suffix = 'tsv'
        publishDir = [ enabled: false ]
    }

    withName: '.*DISCORDANCE:READ_EVIDENCE' {
        // reads with mapping quality >= --evidence_min_mapq; SNV/MNV bases with quality
        // >= --evidence_min_baseq; at most --evidence_max_depth reads per variant; indel
        // haplotypes with --evidence_indel_flank reference bases on each side, reads taken
        // up to --evidence_max_read_length bases from the window; amplicon libraries keep
        // duplicate-flagged reads with --amplicon_keep_duplicates
        ext.args   = { [
                "--min-mapq ${params.evidence_min_mapq}",
                "--min-baseq ${params.evidence_min_baseq}",
                "--max-depth ${params.evidence_max_depth}",
                "--flank ${params.evidence_indel_flank}",
                "--max-read-length ${params.evidence_max_read_length}",
                meta.library_type == 'amplicon' && params.amplicon_keep_duplicates ? '--keep-duplicates' : '',
            ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/discordance/${meta.sample}/read_evidence" },
            mode: params.publish_dir_mode,
            pattern: '*.vcf.gz{,.tbi}'
        ]
    }

    withName: '.*DISCORDANCE:CLASSIFY_DISCORDANCE' {
        // thresholds of the discordance classes and the detection-power model (see docs/output.md)
        ext.args   = { "${params.read_evidence ? '' : '--no-read-evidence '}--min-coverage ${params.min_coverage_tumor} --min-alt-reads ${params.evidence_min_alt_reads} --germline-vaf ${params.germline_vaf} --power-min-alt ${params.power_min_alt_reads} --detection-power ${params.detection_power}" }
        publishDir = [
            path: { "${params.outdir}/discordance/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: '.*DISCORDANCE:AGGREGATE_POWER' {
        // power-adjusted recall (RTG vcfeval TP/FN with the read depth of the query)
        publishDir = [
            path: { "${params.outdir}/benchmark/metrics" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }
}
