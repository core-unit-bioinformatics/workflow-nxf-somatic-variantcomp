/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: VCF preprocessing (subworkflows/local/preprocess_vcf)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    // Steps 3-7 run in the subworkflow NORMALIZE_VCF, called as NORMALIZE_PASS and
    // NORMALIZE_NON_PASS (--filter_pass_only, default) or NORMALIZE_ALL; the prefixes carry
    // the branch (.pass / .non_pass), so that both branches can be concatenated

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_SELECT' {
        // tumor first, then normal; --no-update keeps INFO/AC/AN as written by the caller; BGZF output + index
        ext.args   = { "--samples ${[meta.tumor_id, meta.normal_id].findAll { id -> id }.join(',')} --no-update --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}.select" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_PASS' {
        // step 2b: records with FILTER PASS or '.' (compared)
        ext.args   = '--apply-filters PASS,. --no-update --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.pass" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_NON_PASS' {
        // step 2b: all other records (not compared; DISCORDANCE looks up their FILTER)
        ext.args   = "--exclude 'FILTER=\"PASS\" || FILTER=\".\"' --no-update --output-type z --write-index=tbi"
        ext.prefix = { "${meta.id}.non_pass" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_CONCAT_ALL' {
        // all normalized records: PASS and non-PASS branch, sorted (--allow-overlaps)
        ext.args   = '--allow-overlaps --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.normalized" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.normalized.vcf.gz{,.tbi}'
        ]
    }

    withName: '.*PREPROCESS_VCF:NORMALIZE_.*:BCFTOOLS_ANNOTATE' {
        // the rename map (--rename-chrs) is passed by the module; BGZF output + index
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}${task.process.contains(':NORMALIZE_NON_PASS:') ? '.non_pass' : task.process.contains(':NORMALIZE_PASS:') ? '.pass' : ''}.renamed" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:NORMALIZE_.*:BCFTOOLS_VIEW_CLEAN' {
        // drop gVCF reference blocks (only ALT is <NON_REF> or <*>); records with a real ALT plus <NON_REF> are kept and split later
        ext.args   = "--exclude 'N_ALT==1 && (ALT=\"<NON_REF>\" || ALT=\"<*>\")' --no-update --output-type z --write-index=tbi"
        ext.prefix = { "${meta.id}${task.process.contains(':NORMALIZE_NON_PASS:') ? '.non_pass' : task.process.contains(':NORMALIZE_PASS:') ? '.pass' : ''}.clean" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:NORMALIZE_.*:BCFTOOLS_REHEADER' {
        // contig lines are replaced from the .fai (fixes lengths, adds missing contigs)
        ext.args2  = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}${task.process.contains(':NORMALIZE_NON_PASS:') ? '.non_pass' : task.process.contains(':NORMALIZE_PASS:') ? '.pass' : ''}.reheader" }
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPROCESS_VCF:NORMALIZE_.*:BCFTOOLS_NORM' {
        // split multiallelic records, left-align (needs --fasta-ref, given by the module),
        // atomize MNVs into SNVs, remove records whose REF differs from the reference
        // (counted in the log, which goes to the report; the REF check itself runs in CHECK_INPUTS), remove exact duplicates
        ext.args   = '--multiallelics -any --atomize --check-ref x --rm-dup exact --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}${task.process.contains(':NORMALIZE_NON_PASS:') ? '.non_pass' : task.process.contains(':NORMALIZE_PASS:') ? '.pass' : ''}.norm" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/reference_check" },
            mode: params.publish_dir_mode,
            pattern: '*.norm.log'
        ]
    }

    withName: '.*PREPROCESS_VCF:NORMALIZE_(PASS|NON_PASS):HARMONIZE_VCF' {
        // VAF source (auto: FORMAT/AF, else AD) and the allowed fraction of records without VAF
        ext.args   = { "--vaf-source ${params.vaf_source} --max-missing-vaf ${params.max_missing_vaf}" }
        ext.prefix = { "${meta.id}${task.process.contains(':NORMALIZE_NON_PASS:') ? '.non_pass' : '.pass'}.normalized" }
        // per branch only the summary is published (the VCF: BCFTOOLS_CONCAT_ALL)
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.harmonize_summary.tsv'
        ]
    }

    withName: '.*PREPROCESS_VCF:NORMALIZE_ALL:HARMONIZE_VCF' {
        // VAF source (auto: FORMAT/AF, else AD) and the allowed fraction of records without VAF
        ext.args   = { "--vaf-source ${params.vaf_source} --max-missing-vaf ${params.max_missing_vaf}" }
        ext.prefix = { "${meta.id}.normalized" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.{normalized.vcf.gz,normalized.vcf.gz.tbi,harmonize_summary.tsv}'
        ]
    }

    withName: '.*PREPROCESS_VCF:BCFTOOLS_VIEW_COMPARE' {
        ext.args   = {
            def conditions = []
            if (params.min_vaf > 0)       { conditions << "INFO/VC_T_VAF>=${params.min_vaf}" }
            if (params.min_depth > 0)     { conditions << "INFO/VC_T_DP>=${params.min_depth}" }
            if (params.min_alt_reads > 0) { conditions << "INFO/VC_T_ALT>=${params.min_alt_reads}" }
            [
                conditions ? "--include '${conditions.join(' && ')}'" : '',
                '--targets-overlap record --no-update --output-type z --write-index=tbi'
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.compare" }
        publishDir = [
            path: { "${params.outdir}/vcf_preprocessed/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*.compare.vcf.gz{,.tbi}'
        ]
    }
}
