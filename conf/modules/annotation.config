/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Annotation (subworkflows/local/annotate_variants)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*ANNOTATE_VARIANTS:VARIANTS_TO_VCF' {
        publishDir = [ enabled: false ]
    }

    withName: '.*ANNOTATE_VARIANTS:ENSEMBLVEP_VEP' {
        // VCF output; never a database connection: with a cache --offline (it implies
        // --cache, so it must not be used with --gtf: VEP with --gtf and --fasta runs
        // locally anyway); --vep_args always, --vep_cache_args only with a cache (they need it)
        ext.args   = { [
                '--vcf',
                params.vep_cache ? '--offline' : '',
                params.vep_args,
                params.vep_cache ? params.vep_cache_args : '',
            ].findAll { arg -> arg }.join(' ') }
        ext.prefix = { "${meta.id}.vep" }
        publishDir = [
            path: { "${params.outdir}/annotation/vep" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf.gz,vcf.gz.tbi,html}'
        ]
    }

    withName: '.*ANNOTATE_VARIANTS:BCFTOOLS_SPLITVEP' {
        // one line per variant with the fields of its most severe consequence (-s worst);
        // -H: header line; the columns are read by annotate_variants.py merge
        ext.args   = "-H -s worst -f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%Consequence\\t%SYMBOL\\t%IMPACT\\t%VARIANT_CLASS\\t%BIOTYPE\\n'"
        publishDir = [ enabled: false ]
    }

    withName: '.*ANNOTATE_VARIANTS:GUNZIP_FASTA' {
        publishDir = [ enabled: false ]
    }

    withName: '.*ANNOTATE_VARIANTS:MSISENSORPRO_SCAN' {
        publishDir = [ enabled: false ]
    }

    withName: '.*ANNOTATE_VARIANTS:REPEATS_TO_BED' {
        // the repeat BED can be reused with --repeats_bed (skips the scan)
        publishDir = [
            path: { "${params.outdir}/annotation/repeats" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }

    withName: '.*ANNOTATE_VARIANTS:VARIANTS_TO_BED' {
        publishDir = [ enabled: false ]
    }

    withName: '.*ANNOTATE_VARIANTS:BEDTOOLS_SORT_ANNOTATION' {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [ enabled: false ]
    }

    withName: '.*ANNOTATE_VARIANTS:BEDTOOLS_MAP_REPEATS' {
        // repeat unit (column 4, distinct) and repeat times (column 5, max) of the repeats
        // overlapping a variant; '.' if none
        ext.args   = '-c 4,5 -o distinct,max'
        ext.prefix = { "${meta.id}.repeats" }
        publishDir = [ enabled: false ]
    }

    withName: '.*ANNOTATE_VARIANTS:BEDTOOLS_INTERSECT_STRATA' {
        // -c: number of stratification intervals overlapping each variant
        ext.args   = '-c'
        ext.prefix = { "${meta.id}.counts" }
        publishDir = [ enabled: false ]
    }

    withName: '.*ANNOTATE_VARIANTS:ANNOTATION_MERGE' {
        publishDir = [
            path: { "${params.outdir}/discordance" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }
}
