/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Input checks (workflows/variantcomp, subworkflows/local/check_inputs)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*VARIANTCOMP:CHECK_SAMPLESHEET' {
        // cross-row checks of the samplesheet; the truth technology must occur for every sample
        // alignments are required by --callable_regions / --read_evidence, normal alignments
        // by --callable_regions with --require_normal_coverage
        ext.args   = { [
                "--truth-technology ${params.truth_technology}",
                params.callable_regions ? '--require-tumor-bam callable_regions' : (params.read_evidence ? '--require-tumor-bam read_evidence' : ''),
                params.callable_regions && params.require_normal_coverage ? '--require-normal-bam require_normal_coverage' : '',
            ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*.validated.csv'
        ]
    }

    withName: '.*:CHECK_(STRATIFICATION|KNOWN)' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*.validated.csv'
        ]
    }

    withName: '.*CHECK_INPUTS:CHECK_REFERENCE_VCF' {
        // the tumor/normal columns must exist; REF alleles vs. the FASTA (--check_ref_alleles);
        // contig problems are only warnings with --check_vcf_contigs false
        ext.args   = { [
                "--samples ${[meta.tumor_id, meta.normal_id].findAll { id -> id }.join(',')}",
                "--max-ref-mismatch ${params.max_ref_mismatch}",
                params.check_ref_alleles ? '' : '--skip-ref-alleles',
                params.check_vcf_contigs ? '' : '--warn-only',
                params.keep_mito ? '--keep-mito' : '',
            ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/input_checks/vcf" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*CHECK_INPUTS:CHECK_REFERENCE_BAM' {
        // contig names/lengths of the alignment header; warnings only with --check_bam_contigs false
        ext.args   = { [
                params.check_bam_contigs ? '' : '--warn-only',
                params.keep_mito ? '--keep-mito' : '',
            ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/input_checks/alignments" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*CHECK_INPUTS:CHECK_REFERENCE_BED' {
        // BED format, contig names, interval ends; warnings only with --check_bed_contigs false
        ext.args   = { [
                params.check_bed_contigs ? '' : '--warn-only',
                params.keep_mito ? '--keep-mito' : '',
            ].join(' ').trim() }
        // the role keeps names unique (a stratification may be called like a technology)
        ext.prefix = { "${meta.role}_${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/input_checks/bed" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }

    withName: '.*CHECK_INPUTS:KNOWN_PREPARE' {
        // contigs, positions and REF alleles of the known variants; warnings only with
        // --check_known_variants false
        ext.args   = { [
                params.check_known_variants ? '' : '--warn-only',
                params.keep_mito ? '--keep-mito' : '',
            ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/input_checks/known_variants" },
            mode: params.publish_dir_mode,
            pattern: '*.reference_check.tsv'
        ]
    }
}
