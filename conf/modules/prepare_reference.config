/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Reference index and genome BED (subworkflows/local/prepare_reference)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [ enabled: false ]
    }

    withName: '.*PREPARE_REFERENCE:GAWK_GENOME_BED' {
        // one BED interval per reference contig: name, 0, length (from the .fai); the
        // mitochondrial contig is left out unless --keep_mito (it is not compared)
        ext.args2  = { params.keep_mito
            ? '\'BEGIN { OFS = "\\t" } { print $1, 0, $2 }\''
            : '\'BEGIN { OFS = "\\t" } $1 !~ /^(chrM|MT|M|chrMT)$/ { print $1, 0, $2 }\'' }
        ext.prefix = 'genome'
        publishDir = [ enabled: false ]
    }

    withName: 'GUNZIP' {
        publishDir = [ enabled: false ]
    }
}
