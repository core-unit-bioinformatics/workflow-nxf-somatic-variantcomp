/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: IGV views (subworkflows/local/igv_report, --igv_report)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: '.*IGV_REPORT:IGV_SITES' {
        // sites per page; --flanking / --window only to check that the initial view lies
        // inside the embedded data
        ext.args   = { [
                "--max-sites ${params.igv_max_sites}",
                "--flanking ${params.igv_flanking}",
                params.igv_window ? "--window ${params.igv_window}" : '',
            ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/report/igv" },
            mode: params.publish_dir_mode,
            pattern: 'igv_links.tsv'
        ]
    }

    withName: '.*IGV_REPORT:IGV_TRACKS' {
        // alignment track height (px), igv.js downsampling depth, duplicates of amplicon
        // libraries shown (as in the coverage step)
        ext.args   = { "--height 250 --sampling-depth ${params.igv_sampling_depth} --amplicon-keep-duplicates ${params.amplicon_keep_duplicates}" }
        publishDir = [ enabled: false ]
    }

    withName: '.*IGV_REPORT:IGV_TEMPLATE' {
        publishDir = [ enabled: false ]
    }

    withName: '.*IGV_REPORT:IGVREPORTS' {
        // sites table of bin/igv_inputs.py sites: contig column 2, pos 3, end 4 (1-based,
        // inclusive); every column of the table is shown. --flanking: bases embedded around
        // a site (half on either side); --window: initial view (bp); --exclude-flags: SAM
        // flags removed before the reads are embedded (IGV_TRACKS: 1536 = duplicates + QC
        // fail, 512 if an amplicon library of the sample keeps its duplicates);
        // --subsample only below 1
        ext.args   = { [
                '--sequence 2 --begin 3 --end 4',
                "--flanking ${params.igv_flanking}",
                params.igv_window ? "--window ${params.igv_window}" : '',
                "--exclude-flags ${meta.exclude_flags}",
                params.igv_subsample < 1 ? "--subsample ${params.igv_subsample}" : '',
                "--title \"${meta.sample} part ${meta.id - (meta.sample + '_')}: variantcomp IGV view\"",
            ].join(' ').trim() }
        // <sample>_<part>_report.html (the name in igv_links.tsv)
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/report/igv" },
            mode: params.publish_dir_mode,
            pattern: '*_report.html'
        ]
    }

    withName: '.*IGV_REPORT:IGV_INDEX' {
        // sites per page (shown); paths from report/igv/ to the other reports
        ext.args   = { "--max-sites ${params.igv_max_sites} --multiqc-link ../../multiqc/multiqc_report.html --tables-link ../tables/index.html" }
        publishDir = [
            path: { "${params.outdir}/report/igv" },
            mode: params.publish_dir_mode,
            pattern: 'index.html'
        ]
    }
}
