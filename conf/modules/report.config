/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Report and MultiQC
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'VARIANTCOMP_REPORT' {
        // VAF threshold of the low-VAF enrichment feature; q-value threshold of the tests
        ext.args   = { "--low-vaf ${params.low_vaf} --fdr ${params.enrichment_fdr}" }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            pattern: '{*.tsv,plots/*.png}',
            saveAs: { filename -> filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'CONSISTENCY_CHECKS' {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'REPORT_HTML' {
        // run information in the header of the report; links to the table browser
        // (report/tables) and the MultiQC report (multiqc/), relative to report/
        ext.args   = { "--pipeline-version ${workflow.manifest.version} --run-name ${workflow.runName} --start ${workflow.start.toString().take(19)} --datavzrd-link tables/index.html --multiqc-link ../multiqc/multiqc_report.html" }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            pattern: '*.html'
        ]
    }

    withName: 'DATAVZRD' {
        // output folder report/tables (index.html)
        ext.prefix = 'tables'
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CHECKS_GATE' {
        publishDir = [ enabled: false ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*VARIANTCOMP:MQC_TABLES' {
        // row names without the file suffixes; tables: the first meta.id_columns columns
        // form the row name (default 1)
        ext.args   = { meta.command == 'table' ? "--id-columns ${meta.id_columns ?: 1}" : (meta.id == 'normalization' ? '--strip .norm.norm.log' : (meta.id == 'harmonization' ? '--strip .normalized.harmonize_summary.tsv' : '--strip .reference_check.tsv')) }
        publishDir = [ enabled: false ]
    }
}
