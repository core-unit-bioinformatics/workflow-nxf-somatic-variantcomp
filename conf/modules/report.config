/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Report and MultiQC
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'VARIANTCOMP_REPORT' {
        // VAF threshold of the low-VAF enrichment feature
        ext.args   = { "--low-vaf ${params.low_vaf}" }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            pattern: '{*.tsv,plots/*.png}',
            saveAs: { filename -> filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }
}
