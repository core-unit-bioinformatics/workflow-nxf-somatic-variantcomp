/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options: Report and MultiQC
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by conf/modules.config. Keys: ext.args (ext.args2, ...), ext.prefix,
    publishDir; see the header of conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'VARIANTCOMP_REPORT' {
        // VAF threshold of the low-VAF enrichment feature; q-value threshold of the tests
        ext.args   = { "--low-vaf ${params.low_vaf} --fdr ${params.enrichment_fdr}" }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            pattern: '{*.tsv,plots/*.png}',
            saveAs: { filename -> filename.endsWith('_mqc.tsv') ? null : filename }
        ]
    }

    withName: 'CONSISTENCY_CHECKS' {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'REPORT_CONTENT' {
        // run information; genome build of the Ensembl links (--vep_genome); q-value
        // threshold of the enrichment tests; relative paths between the reports in the
        // output folder: the MultiQC report (multiqc/) links to report/tables, a datavzrd
        // view page (report/tables/<view>/index_1.html) to multiqc/multiqc_report.html;
        // the filter settings of the run for the Introduction
        ext.args   = { "--pipeline-version ${workflow.manifest.version} --run-name ${workflow.runName} --start ${workflow.start.toString().take(19)} --genome ${params.vep_genome} --fdr ${params.enrichment_fdr} --tables-link ../report/tables --multiqc-link ../../../multiqc/multiqc_report.html --filter-pass-only ${params.filter_pass_only} --min-vaf ${params.min_vaf} --min-depth ${params.min_depth} --min-alt-reads ${params.min_alt_reads} --callable-regions ${params.callable_regions}" }
        publishDir = [ enabled: false ]
    }

    withName: 'REPORT_BUNDLE' {
        // report/variantcomp_report.zip: MultiQC report + table browser, links kept
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'DATAVZRD' {
        // output folder report/tables (index.html)
        ext.prefix = 'tables'
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CHECKS_GATE' {
        publishDir = [ enabled: false ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*VARIANTCOMP:MQC_TABLES' {
        // row names without the file suffixes; tables: the first meta.id_columns columns
        // form the row name (default 1)
        ext.args   = { meta.command == 'table' ? "--id-columns ${meta.id_columns ?: 1}" : (meta.id == 'normalization' ? '--strip .norm.norm.log' : (meta.id == 'harmonization' ? '--strip .normalized.harmonize_summary.tsv' : '--strip .reference_check.tsv')) }
        publishDir = [ enabled: false ]
    }
}
